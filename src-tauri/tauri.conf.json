{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IELTS Author Studio",
  "version": "0.1.0",
  "identifier": "com.ielts.author.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IELTS Author Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "resources": [
      "../sidecars"
    ]
  }
}
