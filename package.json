{
  "name": "ielts-author-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Epic 8 Tauri authoring studio for IELTS reading import, review, preview, and NAS publishing.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "verify:phase0": "node scripts/phase0-golden.mjs verify",
    "verify:phase0:strict": "node scripts/phase0-golden.mjs verify --strict",
    "verify:phase0:ci": "node scripts/phase0-golden.mjs verify --ci-contract",
    "test:phase0:cli-freshness": "node scripts/phase0-golden.mjs self-test-cli-freshness",
    "test:phase0:feature-flags": "node scripts/phase0-golden.mjs self-test-feature-flags",
    "verify:phase1:schema": "node scripts/verify-schema-contract.mjs",
    "verify:phase1:schema:local": "node scripts/verify-schema-contract.mjs --local-only",
    "sync:phase1:peer": "node scripts/sync-phase1-peer-contract.mjs",
    "verify:phase2:shadow": "node scripts/verify-phase2-shadow.mjs",
    "verify:phase3:docx-package": "node scripts/verify-phase3-docx-package.mjs",
    "verify:phase3:docx": "node scripts/verify-phase3-docx.mjs",
    "verify:phase4:grammar": "node scripts/verify-phase4-grammar.mjs",
    "verify:phase5:editor": "node scripts/verify-phase5-editor.mjs",
    "verify:phase5:real-pdf": "node scripts/verify-phase5-real-pdf.mjs",
    "capture:phase0-baseline": "node scripts/phase0-golden.mjs capture",
    "register:phase0:private": "node scripts/register-phase0-private-sample.mjs",
    "register:phase0:plan-corpus": "node scripts/register-phase0-plan-corpus.mjs",
    "annotate:phase0:private": "node scripts/annotate-phase0-private-sample.mjs",
    "generate:phase0-synthetic": "python scripts/generate-phase0-synthetic-fixtures.py",
    "register:phase0-synthetic": "python scripts/register-phase0-synthetic-fixtures.py",
    "index:phase0-legacy": "node scripts/index-legacy-corpus.mjs",
    "clean": "node scripts/clean-generated.mjs",
    "clean:deep": "node scripts/clean-generated.mjs --deep",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "e2e:ui-flow": "node sidecars/ui-flow-e2e/ui-flow-e2e.mjs",
    "test:pdf-regression": "node scripts/pdf-regression-sample.mjs",
    "test:pdf-regression:smoke": "node scripts/pdf-regression-sample.mjs --smoke",
    "test:pdf-regression:sample30": "node scripts/pdf-regression-sample.mjs --sample 30",
    "test:live-pdf-regression": "node scripts/live-pdf-pipeline-regression.mjs",
    "audit:package": "node scripts/package-audit.mjs --platform macos",
    "audit:package:macos": "node scripts/package-audit.mjs --platform macos",
    "audit:package:windows": "node scripts/package-audit.mjs --platform windows",
    "audit:windows:signatures": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/audit-windows-signatures.ps1",
    "repack:macos-dmg": "node scripts/repack-macos-dmg.mjs",
    "verify:release": "npm run verify:release:macos",
    "verify:release:macos": "npm run fetch:pdfium && npm run tauri -- build --bundles app,dmg --config src-tauri/tauri.macos.conf.json && npm run repack:macos-dmg && npm run audit:package:macos",
    "verify:release:windows": "npm run fetch:pdfium && npm run tauri -- build --bundles nsis --config src-tauri/tauri.windows.conf.json && npm run audit:package:windows -- src-tauri/tauri.windows.conf.json",
    "verify:release:windows:offline": "npm run fetch:pdfium && npm run tauri -- build --bundles nsis --config src-tauri/tauri.windows.offline.conf.json && npm run audit:package:windows -- src-tauri/tauri.windows.offline.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tiptap/core": "3.30.0",
    "@tiptap/extension-image": "3.30.0",
    "@tiptap/extension-table": "3.30.0",
    "@tiptap/extension-table-cell": "3.30.0",
    "@tiptap/extension-table-header": "3.30.0",
    "@tiptap/extension-table-row": "3.30.0",
    "@tiptap/react": "3.30.0",
    "@tiptap/starter-kit": "3.30.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "ajv": "^8.20.0"
  }
}
