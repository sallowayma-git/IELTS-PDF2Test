{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ielts-author-studio.dev/phase1/quality-report-v2.schema.json",
  "title": "QualityReportV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "documentScore", "sourceCoverage", "coverageLedger", "coverageStatus", "compilerProbes", "taskScores", "hardFailures", "issues", "metrics", "evaluatedAt", "evaluatorVersion"],
  "properties": {
    "schemaVersion": { "const": "QualityReportV2" },
    "state": { "type": "string", "enum": ["ready", "review_required", "blocked"] },
    "documentScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "sourceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "coverageLedger": { "type": "array", "items": { "$ref": "#/$defs/coverageEntry" } },
    "coverageStatus": { "$ref": "#/$defs/coverageStatus" },
    "compilerProbes": { "$ref": "#/$defs/compilerProbes" },
    "taskScores": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
    "hardFailures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/reviewIssue" } },
    "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "evaluatorVersion": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "coverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceNodeId", "significant", "disposition", "targetIds"],
      "properties": {
        "sourceNodeId": { "type": "string", "minLength": 1 },
        "significant": { "const": true },
        "disposition": { "type": "string", "enum": ["assigned", "ignored_with_reason", "unassigned"] },
        "targetIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "ignored_with_reason" } }, "required": ["disposition"] },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "coverageStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicalShadow", "complete", "significantSourceNodeCount", "explainedSourceNodeCount", "unassignedSourceNodeIds"],
      "properties": {
        "physicalShadow": { "type": "string", "enum": ["available", "missing"] },
        "complete": { "type": "boolean" },
        "significantSourceNodeCount": { "type": "integer", "minimum": 0 },
        "explainedSourceNodeCount": { "type": "integer", "minimum": 0 },
        "unassignedSourceNodeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "compilerProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "schemaVersion", "issueCodes", "details"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed"] },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "issueCodes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "details": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "compilerProbes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v2Runtime", "v1Compatibility"],
      "properties": {
        "v2Runtime": { "$ref": "#/$defs/compilerProbe" },
        "v1Compatibility": { "$ref": "#/$defs/compilerProbe" }
      }
    },
    "reviewIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "code", "severity", "message", "targetType", "targetId", "sourceAnchors", "suggestedActions"],
      "properties": {
        "issueId": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["info", "warning", "blocking"] },
        "message": { "type": "string", "minLength": 1 },
        "targetType": { "type": "string", "enum": ["document", "page", "region", "task", "response_group", "slot", "asset"] },
        "targetId": { "type": "string", "minLength": 1 },
        "sourceAnchors": { "type": "array", "items": { "$ref": "./common-v2.schema.json#/$defs/sourceAnchor" } },
        "suggestedActions": {
          "type": "array",
          "items": { "type": "string", "enum": ["assign_role", "edit_text", "merge_lines", "split_prompt", "attach_option_bank", "confirm_table", "confirm_figure", "replace_asset", "enter_answer", "ignore_with_reason"] }
        },
        "details": { "type": "object" }
      }
    }
  }
}
